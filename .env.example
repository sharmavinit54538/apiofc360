APP_NAME="OFC HR – Office Function Consolidator (Human Resources)"
APP_VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
# ── Environment & Security Documentation Control ─────────────────────────────
# ENVIRONMENT: "local" | "development" | "production" (Production mode disables /docs, /redoc, /openapi.json)
ENVIRONMENT="local"

# DEBUG: true | false (Set to false in production to disable debug mode & prevent data leaks)
DEBUG=true

# ENABLE_DOCS: true | false (Explicit override: false = block /docs, /redoc, /openapi.json completely)
ENABLE_DOCS=true

LOG_LEVEL="INFO"

# ── PostgreSQL Database Credentials ─────────────────────────────────────────
POSTGRES_USER="your_db_user"
POSTGRES_PASSWORD="CHANGE_ME_strong_password"
POSTGRES_DB="ofc360"
POSTGRES_HOST="db"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://your_db_user:CHANGE_ME_strong_password@db:5432/ofc360"
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── Redis / Celery Configuration ─────────────────────────────────────────────
REDIS_URL="redis://redis:6379/0"
CELERY_BROKER_URL="redis://redis:6379/1"
CELERY_RESULT_BACKEND="redis://redis:6379/2"

# ── Security & Authentication ────────────────────────────────────────────────
SECRET_KEY="CHANGE_ME_generate_with_openssl_rand_hex_32"
JWT_ALGORITHM="RS256"
# JWT_PRIVATE_KEY and JWT_PUBLIC_KEY are required in production (RS256).
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

BCRYPT_ROUNDS=12
BACKEND_CORS_ORIGINS=["https://your-domain.com","http://localhost:8080"]
ALLOWED_ORIGINS=["https://your-domain.com","http://localhost:8080"]

REGISTER_RATE_LIMIT="5/minute"
LOGIN_RATE_LIMIT_LIMIT=5
LOGIN_RATE_LIMIT_WINDOW=60

OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# ── Super Admin ──────────────────────────────────────────────────────────────
# Required in production. Must be a strong password.
SUPER_ADMIN_PASSWORD="CHANGE_ME_strong_admin_password"
# Set to "true" to force-reset super admin password on next startup
RESET_SUPER_ADMIN_PASSWORD=false

# ── SMTP Configuration ────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="CHANGE_ME_smtp_app_password"
SMTP_FROM_EMAIL="your-email@gmail.com"
SMTP_FROM_NAME="OFC HR Portal"
SMTP_USE_TLS=true
SMTP_USE_SSL=false
COMPANY_LOGO_URL="https://dummyimage.com/160x48/0f172a/ffffff&text=HRMS"

COMPANY_EMAIL_DOMAIN="your-domain.com"
ACTIVATION_TOKEN_EXPIRE_HOURS=72
FRONTEND_BASE_URL="https://your-domain.com"


# ── Cloudinary Settings ───────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="CHANGE_ME_cloud_name"
CLOUDINARY_API_KEY="CHANGE_ME_api_key"
CLOUDINARY_API_SECRET="CHANGE_ME_api_secret"

# ── Ollama Configuration ──────────────────────────────────────────────────────
OLLAMA_ENABLED=true
OLLAMA_BASE_URL="http://host.docker.internal:11434"
OLLAMA_MODEL="qwen3:30b"
OLLAMA_TIMEOUT=120
OLLAMA_PRIORITY=1

# Granular Ollama HTTP timeouts (seconds)
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_READ_TIMEOUT=120
OLLAMA_WRITE_TIMEOUT=10
OLLAMA_POOL_TIMEOUT=5

# AI Chat endpoint tuning
AI_CHAT_NUM_PREDICT=512
AI_CHAT_TEMPERATURE=0.2
AI_MAX_CONTEXT_MESSAGES=10
AI_REQUEST_DEDUP_WINDOW_SECONDS=5

LLM_PRIMARY_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=120
LLM_RATE_LIMIT_RPM=60
LLM_DAILY_BUDGET_USD=100.0

# ── Razorpay Payment Gateway Credentials ────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
VITE_RAZORPAY_KEY_ID=""

# ── GitHub OAuth Configuration ───────────────────────────────────────────────
GITHUB_CLIENT_ID="CHANGE_ME_github_client_id"
GITHUB_CLIENT_SECRET="CHANGE_ME_github_client_secret"
GITHUB_REDIRECT_URI=""

# ── Google OAuth Configuration ───────────────────────────────────────────────
GOOGLE_CLIENT_ID="CHANGE_ME_google_client_id"
GOOGLE_CLIENT_SECRET="CHANGE_ME_google_client_secret"
GOOGLE_REDIRECT_URI=""

