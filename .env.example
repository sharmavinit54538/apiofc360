APP_NAME="OFC HR – Office Function Consolidator (Human Resources)"
APP_VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
# ── Environment & Security Documentation Control ─────────────────────────────
# ENVIRONMENT: "local" | "development" | "production" (Production mode disables /docs, /redoc, /openapi.json)
ENVIRONMENT="local"

# DEBUG: true | false (Set to false in production to disable debug mode & prevent data leaks)
DEBUG=false

# ENABLE_DOCS: true | false (Explicit override: false = block /docs, /redoc, /openapi.json completely)
ENABLE_DOCS=false

LOG_LEVEL="INFO"

# ── PostgreSQL Database Credentials ─────────────────────────────────────────
POSTGRES_USER="admin"
POSTGRES_PASSWORD="7y1812xhKIHW"
POSTGRES_DB="ofc360"
POSTGRES_HOST="db"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://admin:7y1812xhKIHW@db:5432/ofc360"
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── Redis / Celery Configuration ─────────────────────────────────────────────
REDIS_URL="redis://redis:6379/0"
CELERY_BROKER_URL="redis://redis:6379/1"
CELERY_RESULT_BACKEND="redis://redis:6379/2"

