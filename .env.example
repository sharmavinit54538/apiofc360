APP_NAME="HRMS Register API"
APP_VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="local"
DEBUG=false
LOG_LEVEL="INFO"

DATABASE_URL="postgresql+psycopg://postgres:Bindu%40134366@localhost:5432/equnixsphere_prod"
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

SECRET_KEY="replace-this-with-a-strong-random-secret-at-least-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

BCRYPT_ROUNDS=12
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8000"
REGISTER_RATE_LIMIT="5/minute"
LOGIN_RATE_LIMIT_LIMIT=5
LOGIN_RATE_LIMIT_WINDOW=60

OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ── SMTP Configuration ────────────────────────────────────────────────────────
# Gmail STARTTLS (recommended):  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USE_TLS=true  SMTP_USE_SSL=false
# Gmail SSL:                     SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USE_TLS=false SMTP_USE_SSL=true
# Office 365:                    SMTP_HOST=smtp.office365.com SMTP_PORT=587 SMTP_USE_TLS=true SMTP_USE_SSL=false
# Local MailHog (dev):           SMTP_HOST=localhost SMTP_PORT=1025 SMTP_USE_TLS=false SMTP_USE_SSL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=HRMS Portal
SMTP_USE_TLS=true
SMTP_USE_SSL=false

COMPANY_LOGO_URL="https://dummyimage.com/160x48/0f172a/ffffff&text=HRMS"
COMPANY_EMAIL_DOMAIN="company.com"
ACTIVATION_TOKEN_EXPIRE_HOURS=72
FRONTEND_BASE_URL="http://localhost:3000"
