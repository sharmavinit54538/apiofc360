ACCESS_TOKEN_EXPIRE_MINUTES=525600
REFRESH_TOKEN_EXPIRE_DAYS=30

BCRYPT_ROUNDS=12
BACKEND_CORS_ORIGINS=["https://api.ofc360.com","https://ofc360.com","https://www.ofc360.com","http://127.0.0.1:8001","http://localhost:8000","http://localhost:3000"]
ALLOWED_ORIGINS=["https://api.ofc360.com","https://ofc360.com","https://www.ofc360.com","http://localhost:8080","http://127.0.0.1:8080","http://192.168.31.230:8080","http://localhost:5173","http://127.0.0.1:5173"]

